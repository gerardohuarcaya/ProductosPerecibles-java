<%@page import="java.util.List,model.Producto"%><%@page contentType="text/html" pageEncoding="UTF-8"%>
<% List<Producto> productos=(List<Producto>)request.getAttribute("productos"); String buscar=request.getParameter("buscar"); %>
<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Productos</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/estilos.css"></head><body><div class="contenedor"><%@ include file="/WEB-INF/vistas/sidebar.jsp" %><main class="contenido-principal"><%request.setAttribute("tituloPagina","Productos");%><%@ include file="/WEB-INF/vistas/header.jsp" %>
<section class="seccion-productos"><form action="${pageContext.request.contextPath}/ProductoServlet" method="get"><label for="buscar">Buscar producto:</label><input id="buscar" name="buscar" value="<%=buscar==null?"":buscar%>" placeholder="Código, nombre o categoría"><button>Buscar</button></form><a href="${pageContext.request.contextPath}/ProductoServlet?accion=nuevo">Registrar producto</a>
<div class="tabla-contenedor"><table><thead><tr><th>Código</th><th>Nombre</th><th>Categoría</th><th>Cantidad</th><th>Vencimiento</th><th>Acciones</th></tr></thead><tbody>
<%if(productos!=null&&!productos.isEmpty()){for(Producto p:productos){%><tr><td><%=p.getCodigo()%></td><td><%=p.getNombre()%></td><td><%=p.getCategoria()%></td><td><%=p.getCantidad()%></td><td><%=p.getFechaVencimiento()%></td><td><a href="${pageContext.request.contextPath}/ProductoServlet?accion=detalle&id=<%=p.getIdProducto()%>">Ver</a> | <a href="${pageContext.request.contextPath}/ProductoServlet?accion=editar&id=<%=p.getIdProducto()%>">Editar</a> | <a href="${pageContext.request.contextPath}/ProductoServlet?accion=eliminar&id=<%=p.getIdProducto()%>" onclick="return confirm('¿Eliminar?')">Eliminar</a></td></tr><%}}else{%><tr><td colspan="6">No hay productos registrados.</td></tr><%}%>
</tbody></table></div></section><%@ include file="/WEB-INF/vistas/footer.jsp" %></main></div></body></html>