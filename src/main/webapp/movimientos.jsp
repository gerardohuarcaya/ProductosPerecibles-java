<%@page import="java.util.List,model.Movimiento"%><%@page contentType="text/html" pageEncoding="UTF-8"%><%List<Movimiento> lista=(List<Movimiento>)request.getAttribute("movimientos");String tipo=request.getParameter("tipo");%>
<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Movimientos</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/estilos.css"></head><body><div class="contenedor"><%@ include file="/WEB-INF/vistas/sidebar.jsp" %><main class="contenido-principal"><%request.setAttribute("tituloPagina","Movimientos");%><%@ include file="/WEB-INF/vistas/header.jsp" %>
<form action="${pageContext.request.contextPath}/MovimientoServlet"><label>Tipo</label><select name="tipo"><option value="">Todos</option><option value="ENTRADA" <%= "ENTRADA".equals(tipo)?"selected":"" %>>Entrada</option><option value="SALIDA" <%= "SALIDA".equals(tipo)?"selected":"" %>>Salida</option></select><button>Filtrar</button></form>
<table><thead><tr><th>Código</th><th>Producto</th><th>Tipo</th><th>Cantidad</th><th>Fecha</th><th>Usuario</th><th>Observación</th></tr></thead><tbody><%if(lista!=null&&!lista.isEmpty()){for(Movimiento m:lista){%><tr><td><%=m.getCodigo()%></td><td><%=m.getNombreProducto()%></td><td><%=m.getTipo()%></td><td><%=m.getCantidad()%></td><td><%=m.getFecha()%></td><td><%=m.getNombreUsuario()%></td><td><%=m.getObservacion()==null?"":m.getObservacion()%></td></tr><%}}else{%><tr><td colspan="7">No hay movimientos registrados.</td></tr><%}%></tbody></table>
<%@ include file="/WEB-INF/vistas/footer.jsp" %></main></div></body></html>